# =============================================================================
# LEADPILOT AI & DORK INTELLIGENCE ENGINE
# Environment Variables Template
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# Purpose: Connection string for SQLite or PostgreSQL.
# Required: YES
# Default: sqlite:///leadpilot.db
DATABASE_URL=sqlite:///leadpilot.db

# ── LLM Settings ─────────────────────────────────────────────────────────────
# Purpose: Specify the LLM provider (groq, openai, openrouter)
# Required: YES
# Default: groq
LLM_PROVIDER=groq

# Purpose: Model for Dork Intelligence Trend Analysis
# Required: NO
# Default: llama-3.1-8b-instant
TREND_MODEL=llama-3.1-8b-instant

# Purpose: Model for Dork Generation
# Required: NO
# Default: llama-3.1-8b-instant
DORK_MODEL=llama-3.1-8b-instant

# Purpose: Model for Outreach Generation (LeadPilot)
# Required: NO
# Default: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# ── API Keys ─────────────────────────────────────────────────────────────────
# Purpose: Groq API Key (Required if LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here

# Purpose: OpenAI API Key (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Purpose: OpenRouter API Key (Required if LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Purpose: Serper API Key for bulk scraping
# Required: YES
SERPER_API_KEY=your_serper_api_key_here

# Purpose: NewsData API Key for live intelligence
# Required: NO (will use mocked trends if empty)
NEWSDATA_API_KEY=your_newsdata_api_key_here

# ── Development & Demo ───────────────────────────────────────────────────────
# Purpose: Toggle Demo Mode for frontend
# Required: NO
# Default: false
DEMO_MODE=false

# ── Outreach Settings ────────────────────────────────────────────────────────
# Purpose: Identity of the sender for outreach emails
# Required: NO
SENDER_NAME=Deepak Kishor
SENDER_ROLE=Founder & Lead Strategist
AGENCY_WEBSITE=3fitech.com

# ── MailForge / SMTP ─────────────────────────────────────────────────────────
# Purpose: MailForge Encryption Key for credentials
# Required: NO
MAILFORGE_SECRET_KEY=your_encryption_key_here

DEFAULT_SMTP_HOST=smtp.gmail.com
DEFAULT_SMTP_PORT=587
DEFAULT_SMTP_USE_TLS=true
